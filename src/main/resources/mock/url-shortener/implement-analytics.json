package com.example.generated.urlshortener;

import java.sql.*;
import java.time.Instant;
import java.util.LinkedHashMap;
import java.util.Map;

public final class AnalyticsService {

    private final String jdbcUrl;

    public AnalyticsService(String jdbcUrl) {
        this.jdbcUrl = jdbcUrl;
        initialize();
    }

    private void initialize() {
        try (Connection connection =
                     DriverManager.getConnection(jdbcUrl);
             Statement statement = connection.createStatement()) {

            statement.execute("""
                    CREATE TABLE IF NOT EXISTS click_event (
                        id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                        code VARCHAR(7) NOT NULL,
                        clicked_at TIMESTAMP NOT NULL
                    )
                    """);

        } catch (SQLException e) {
            throw new IllegalStateException(
                    "Cannot initialize click_event", e);
        }
    }

    public void record(ClickEvent event) {
        try (Connection connection =
                     DriverManager.getConnection(jdbcUrl);
             PreparedStatement statement = connection.prepareStatement(
                     "INSERT INTO click_event(code, clicked_at) VALUES (?, ?)")) {

            statement.setString(1, event.code());
            statement.setTimestamp(
                    2, Timestamp.from(event.clickedAt()));

            statement.executeUpdate();

        } catch (SQLException e) {
            throw new IllegalStateException(
                    "Cannot persist click event", e);
        }
    }

    public AnalyticsStats stats(String code) {
        long total = 0;
        Instant last = null;
        Map<String, Long> daily = new LinkedHashMap<>();

        try (Connection connection =
                     DriverManager.getConnection(jdbcUrl)) {

            try (PreparedStatement statement =
                         connection.prepareStatement(
                                 "SELECT COUNT(*), MAX(clicked_at) " +
                                 "FROM click_event WHERE code=?")) {

                statement.setString(1, code);

                try (ResultSet rs = statement.executeQuery()) {
                    if (rs.next()) {
                        total = rs.getLong(1);

                        Timestamp timestamp = rs.getTimestamp(2);

                        if (timestamp != null) {
                            last = timestamp.toInstant();
                        }
                    }
                }
            }

            try (PreparedStatement statement =
                         connection.prepareStatement("""
                    SELECT CAST(clicked_at AS DATE) AS click_day,
                           COUNT(*)
                    FROM click_event
                    WHERE code=?
                    GROUP BY CAST(clicked_at AS DATE)
                    ORDER BY click_day
                    """)) {

                statement.setString(1, code);

                try (ResultSet rs = statement.executeQuery()) {
                    while (rs.next()) {
                        daily.put(
                                rs.getDate(1)
                                        .toLocalDate()
                                        .toString(),
                                rs.getLong(2));
                    }
                }
            }

        } catch (SQLException e) {
            throw new IllegalStateException(
                    "Cannot query analytics", e);
        }

        return new AnalyticsStats(total, daily, last);
    }
}
