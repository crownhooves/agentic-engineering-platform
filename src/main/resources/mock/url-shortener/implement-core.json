package com.example.generated.urlshortener;

import com.sun.net.httpserver.HttpExchange;
import com.sun.net.httpserver.HttpServer;
import java.io.IOException;
import java.io.OutputStream;
import java.net.InetSocketAddress;
import java.net.URI;
import java.nio.charset.StandardCharsets;
import java.util.Optional;
import java.util.concurrent.Executors;

public final class ShortenerHttpServer {
    private final ShortenerService service;
    private final AnalyticsService analytics;
    private HttpServer server;

    public ShortenerHttpServer(ShortenerService service, AnalyticsService analytics) {
        this.service = service;
        this.analytics = analytics;
    }

    public void start(int port) throws IOException {
        server = HttpServer.create(new InetSocketAddress("127.0.0.1", port), 0);
        server.createContext("/api/links", this::handleLinks);
        server.createContext("/", this::handleRedirect);
        server.setExecutor(Executors.newCachedThreadPool());
        server.start();
    }

    public int port() {
        return server.getAddress().getPort();
    }

    public void stop() {
        if (server != null) {
            server.stop(0);
        }
    }

    private void handleLinks(HttpExchange exchange) throws IOException {
        try {
            String path = exchange.getRequestURI().getPath();

            if ("POST".equals(exchange.getRequestMethod()) && "/api/links".equals(path)) {
                String body = new String(exchange.getRequestBody().readAllBytes(), StandardCharsets.UTF_8);
                String url = jsonValue(body, "url");
                String alias = jsonValue(body, "alias");

                ShortUrl created = service.create(url, alias);
                send(exchange, 201,
                        "{\"code\":\"" + escape(created.code()) +
                        "\",\"url\":\"" + escape(created.originalUrl()) + "\"}");
                return;
            }

            if ("GET".equals(exchange.getRequestMethod()) && path.startsWith("/api/links/")
                    && path.endsWith("/stats")) {
                String code = path.substring("/api/links/".length(),
                        path.length() - "/stats".length());

                if (service.resolveWithoutRecording(code).isEmpty()) {
                    send(exchange, 404, "{\"error\":\"not found\"}");
                    return;
                }

                AnalyticsStats stats = analytics.stats(code);
                send(exchange, 200,
                        "{\"totalClicks\":" + stats.totalClicks()
                                + ",\"lastClick\":\""
                                + (stats.lastClick() == null ? "" : stats.lastClick())
                                + "\"}");
                return;
            }

            send(exchange, 404, "{\"error\":\"not found\"}");
        } catch (ShortenerService.InvalidUrlException | ShortenerService.InvalidAliasException e) {
            send(exchange, 400, "{\"error\":\"" + escape(e.getMessage()) + "\"}");
        } catch (ShortenerService.AliasConflictException e) {
            send(exchange, 409, "{\"error\":\"" + escape(e.getMessage()) + "\"}");
        }
    }

    private void handleRedirect(HttpExchange exchange) throws IOException {
        if (!"GET".equals(exchange.getRequestMethod())) {
            send(exchange, 405, "{\"error\":\"method not allowed\"}");
            return;
        }

        String path = exchange.getRequestURI().getPath();
        String code = path.startsWith("/") ? path.substring(1) : path;

        Optional<ShortUrl> resolved = service.resolve(code);
        if (resolved.isEmpty()) {
            send(exchange, 404, "{\"error\":\"not found\"}");
            return;
        }

        exchange.getResponseHeaders().set("Location", resolved.get().originalUrl());
        exchange.sendResponseHeaders(302, -1);
        exchange.close();
    }

    private static void send(HttpExchange exchange, int status, String body) throws IOException {
        byte[] bytes = body.getBytes(StandardCharsets.UTF_8);
        exchange.getResponseHeaders().set("Content-Type", "application/json");
        exchange.sendResponseHeaders(status, bytes.length);
        try (OutputStream output = exchange.getResponseBody()) {
            output.write(bytes);
        }
    }

    private static String jsonValue(String body, String key) {
        String marker = "\"" + key + "\"";
        int start = body.indexOf(marker);
        if (start < 0) return null;
        int colon = body.indexOf(':', start + marker.length());
        if (colon < 0) return null;
        int firstQuote = body.indexOf('"', colon + 1);
        if (firstQuote < 0) return null;
        int secondQuote = body.indexOf('"', firstQuote + 1);
        if (secondQuote < 0) return null;
        return body.substring(firstQuote + 1, secondQuote);
    }

    private static String escape(String value) {
        if (value == null) return "";
        return value.replace("\\", "\\\\").replace("\"", "\\\"");
    }
}
