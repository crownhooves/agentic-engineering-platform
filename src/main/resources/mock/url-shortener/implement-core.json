package com.example.generated.urlshortener;

import java.sql.*;
import java.time.Instant;
import java.util.Optional;

public final class JdbcShortUrlRepository implements ShortUrlRepository {
    private final String jdbcUrl;

    public JdbcShortUrlRepository(String jdbcUrl) {
        this.jdbcUrl = jdbcUrl;
        initialize();
    }

    private Connection connection() throws SQLException {
        return DriverManager.getConnection(jdbcUrl);
    }

    private void initialize() {
        try (Connection c = connection();
             Statement s = c.createStatement()) {
            s.execute("""
                    CREATE TABLE IF NOT EXISTS short_url (
                        id BIGINT GENERATED BY DEFAULT AS IDENTITY PRIMARY KEY,
                        code VARCHAR(7) UNIQUE NOT NULL,
                        original_url VARCHAR(2048) NOT NULL,
                        alias VARCHAR(32) UNIQUE,
                        created_at TIMESTAMP NOT NULL
                    )
                    """);
        } catch (SQLException e) {
            throw new IllegalStateException("Cannot initialize short_url table", e);
        }
    }

    @Override
    public ShortUrl create(String originalUrl, String alias) {
        try (Connection c = connection()) {
            long id;

            try (PreparedStatement ps = c.prepareStatement(
                    "INSERT INTO short_url(code, original_url, alias, created_at) VALUES (?, ?, ?, ?)",
                    Statement.RETURN_GENERATED_KEYS)) {
                ps.setString(1, "0000000");
                ps.setString(2, originalUrl);
                if (alias == null) {
                    ps.setNull(3, Types.VARCHAR);
                } else {
                    ps.setString(3, alias);
                }
                Instant created = Instant.now();
                ps.setTimestamp(4, Timestamp.from(created));
                ps.executeUpdate();

                try (ResultSet rs = ps.getGeneratedKeys()) {
                    if (!rs.next()) {
                        throw new IllegalStateException("Database did not return generated id");
                    }
                    id = rs.getLong(1);
                }

                String code = Base62.encode(id);

                try (PreparedStatement update =
                             c.prepareStatement("UPDATE short_url SET code=? WHERE id=?")) {
                    update.setString(1, code);
                    update.setLong(2, id);
                    update.executeUpdate();
                }

                return new ShortUrl(id, code, originalUrl, alias, created);
            }
        } catch (SQLException e) {
            throw new IllegalStateException("Cannot persist short URL", e);
        }
    }

    @Override
    public Optional<ShortUrl> findByCode(String code) {
        try (Connection c = connection();
             PreparedStatement ps = c.prepareStatement(
                     "SELECT id, code, original_url, alias, created_at FROM short_url WHERE code=?")) {
            ps.setString(1, code);
            try (ResultSet rs = ps.executeQuery()) {
                if (!rs.next()) {
                    return Optional.empty();
                }
                return Optional.of(new ShortUrl(
                        rs.getLong("id"),
                        rs.getString("code"),
                        rs.getString("original_url"),
                        rs.getString("alias"),
                        rs.getTimestamp("created_at").toInstant()));
            }
        } catch (SQLException e) {
            throw new IllegalStateException("Cannot find short URL", e);
        }
    }

    @Override
    public boolean existsByAlias(String alias) {
        try (Connection c = connection();
             PreparedStatement ps = c.prepareStatement(
                     "SELECT 1 FROM short_url WHERE alias=?")) {
            ps.setString(1, alias);
            try (ResultSet rs = ps.executeQuery()) {
                return rs.next();
            }
        } catch (SQLException e) {
            throw new IllegalStateException("Cannot check alias", e);
        }
    }
}
