package com.example.generated.urlshortener;

import static org.junit.jupiter.api.Assertions.*;

import java.util.Optional;
import org.junit.jupiter.api.Test;

class JdbcShortUrlRepositoryTest {

    @Test
    void persistsAndReadsLinkFromH2() {
        String url =
                "jdbc:h2:mem:links_" + System.nanoTime()
                        + ";DB_CLOSE_DELAY=-1";

        JdbcShortUrlRepository repository =
                new JdbcShortUrlRepository(url);

        ShortUrl created =
                repository.create(
                        "https://example.com",
                        "hello");

        Optional<ShortUrl> found =
                repository.findByCode(created.code());

        assertTrue(found.isPresent());
        assertEquals(
                "https://example.com",
                found.get().originalUrl());

        assertTrue(repository.existsByAlias("hello"));
    }
}
