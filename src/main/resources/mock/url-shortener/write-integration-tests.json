package com.example.generated.urlshortener;

import static org.junit.jupiter.api.Assertions.*;

import java.time.Instant;
import org.junit.jupiter.api.Test;

class AnalyticsServiceTest {

    @Test
    void recordsAndAggregatesClicks() {
        String url =
                "jdbc:h2:mem:analytics_" + System.nanoTime()
                        + ";DB_CLOSE_DELAY=-1";

        AnalyticsService service =
                new AnalyticsService(url);

        Instant first = Instant.parse(
                "2026-09-30T10:00:00Z");

        service.record(
                new ClickEvent("abc1234", first));

        service.record(
                new ClickEvent(
                        "abc1234",
                        first.plusSeconds(60)));

        AnalyticsStats stats =
                service.stats("abc1234");

        assertEquals(2, stats.totalClicks());
        assertEquals(first.plusSeconds(60),
                stats.lastClick());

        assertEquals(
                2L,
                stats.clicksPerDay()
                        .get("2026-09-30"));
    }
}
