package com.example.generated.urlshortener;

import static org.junit.jupiter.api.Assertions.*;

import java.net.HttpURLConnection;
import java.net.URI;
import java.net.URL;
import java.util.Optional;
import org.junit.jupiter.api.Test;

class ShortenerHttpServerTest {

    @Test
    void redirectReturns302AndLocation() throws Exception {
        FakeRepository repository =
                new FakeRepository();

        RecordingClickRecorder recorder =
                new RecordingClickRecorder();

        ShortenerService service =
                new ShortenerService(
                        repository,
                        recorder);

        ShortUrl created =
                service.create(
                        "https://example.com/target",
                        null);

        AnalyticsService analytics =
                new AnalyticsService(
                        "jdbc:h2:mem:http_"
                                + System.nanoTime()
                                + ";DB_CLOSE_DELAY=-1");

        ShortenerHttpServer server =
                new ShortenerHttpServer(
                        service,
                        analytics);

        server.start(0);

        try {
            URL url = URI.create(
                    "http://127.0.0.1:"
                            + server.port()
                            + "/"
                            + created.code()).toURL();

            HttpURLConnection connection =
                    (HttpURLConnection) url.openConnection();

            connection.setInstanceFollowRedirects(false);

            assertEquals(
                    302,
                    connection.getResponseCode());

            assertEquals(
                    "https://example.com/target",
                    connection.getHeaderField("Location"));

        } finally {
            server.stop();
        }
    }

    @Test
    void unknownCodeReturns404() throws Exception {
        ShortenerService service =
                new ShortenerService(
                        new FakeRepository(),
                        event -> {});

        AnalyticsService analytics =
                new AnalyticsService(
                        "jdbc:h2:mem:http404_"
                                + System.nanoTime()
                                + ";DB_CLOSE_DELAY=-1");

        ShortenerHttpServer server =
                new ShortenerHttpServer(
                        service,
                        analytics);

        server.start(0);

        try {
            URL url = URI.create(
                    "http://127.0.0.1:"
                            + server.port()
                            + "/missing").toURL();

            HttpURLConnection connection =
                    (HttpURLConnection) url.openConnection();

            assertEquals(
                    404,
                    connection.getResponseCode());

        } finally {
            server.stop();
        }
    }

    private static final class FakeRepository
            implements ShortUrlRepository {

        private long id = 1;
        private ShortUrl stored;

        @Override
        public ShortUrl create(
                String url,
                String alias) {

            stored = new ShortUrl(
                    id,
                    Base62.encode(id),
                    url,
                    alias,
                    java.time.Instant.now());

            id++;
            return stored;
        }

        @Override
        public Optional<ShortUrl> findByCode(
                String code) {

            return stored != null
                    && stored.code().equals(code)
                    ? Optional.of(stored)
                    : Optional.empty();
        }

        @Override
        public boolean existsByAlias(
                String alias) {

            return stored != null
                    && alias.equals(stored.alias());
        }
    }

    private static final class RecordingClickRecorder
            implements ClickRecorder {

        int count;

        @Override
        public void record(ClickEvent event) {
            count++;
        }
    }
}
