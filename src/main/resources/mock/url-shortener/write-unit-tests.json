package com.example.generated.urlshortener;

import static org.junit.jupiter.api.Assertions.*;

import org.junit.jupiter.api.Test;

class Base62Test {

    @Test
    void zeroIsSevenCharacters() {
        assertEquals("0000000", Base62.encode(0));
    }

    @Test
    void encodingIsStable() {
        assertEquals(Base62.encode(12345), Base62.encode(12345));
    }

    @Test
    void negativeValuesAreRejected() {
        assertThrows(
                IllegalArgumentException.class,
                () -> Base62.encode(-1));
    }
}
